{
  "family": "multiagent-ideation-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::891067072053:role/multiagent-ideation-execution-role",
  "taskRoleArn": "arn:aws:iam::891067072053:role/multiagent-ideation-task-role",
  "containerDefinitions": [
    {
      "name": "multiagent-ideation",
      "image": "891067072053.dkr.ecr.us-east-1.amazonaws.com/multiagent-ideation:lean",
      "essential": true,
      "memory": 4096,
      "cpu": 2048,
      "environment": [
        {
          "name": "USE_AWS_BEDROCK",
          "value": "true"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "GENERATOR_MODEL",
          "value": "claude-sonnet-4.5"
        },
        {
          "name": "CRITIC_MODEL",
          "value": "claude-sonnet-4.5"
        },
        {
          "name": "SYNTHESIZER_MODEL",
          "value": "claude-sonnet-4.5"
        },
        {
          "name": "DISRUPTOR_MODEL",
          "value": "claude-sonnet-4.5"
        },
        {
          "name": "STRATEGIST_MODEL",
          "value": "claude-sonnet-4.5"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/multiagent-ideation",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "command": [
        "python",
        "main.py",
        "generate",
        "--prompt",
        "Sample SaaS idea",
        "--num-ideas",
        "5",
        "--use-search"
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c 'import sys; sys.exit(0)' || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ],
  "tags": [
    {
      "key": "Environment",
      "value": "production"
    },
    {
      "key": "Application",
      "value": "multiagent-ideation"
    },
    {
      "key": "ManagedBy",
      "value": "terraform"
    }
  ]
}

